# Copy this file to .env and fill in your key. Never commit .env.

# The ONE key the project needs. Create it free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Which Gemma 4 model reads the sketch.
#   gemma-4-31b-it       best accuracy (default)
#   gemma-4-26b-a4b-it   faster, slightly lighter
GEMMA_MODEL=gemma-4-31b-it

# Set to 0 to turn off the "Run code" button (recommended for any public deployment).
ENABLE_RUN=1

# Set to 1 to skip the model and return a canned example (offline / no-key fallback for demos).
DEMO_MODE=0
